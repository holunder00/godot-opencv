import os
import glob

env = SConscript("godot-cpp/SConstruct")

# --- Static OpenCV ---
# Order matters for static linking: dependents before dependencies.
OPENCV_MODULES = [
    "opencv_objdetect",
    "opencv_calib3d",
    "opencv_features2d",
    "opencv_videoio",
    "opencv_imgcodecs",
    "opencv_flann",      # needed by features2d/calib3d
    "opencv_imgproc",
    "opencv_core",
]

opencv = os.environ.get("OPENCV_DIR")
if not opencv:
    print("ERROR: OPENCV_DIR environment variable not set")
    Exit(1)

platform = env["platform"]

if platform == "windows":
    env.Append(CPPPATH=[os.path.join(opencv, "include")])

    # Static install layout: <prefix>/x64/vc*/staticlib
    candidates = glob.glob(os.path.join(opencv, "x64", "vc*", "staticlib"))
    if not candidates:
        # source-install layout can also be <prefix>/staticlib or <prefix>/lib
        candidates = [p for p in [os.path.join(opencv, "staticlib"),
                                  os.path.join(opencv, "lib")] if os.path.exists(p)]
    libdir = candidates[0]
    env.Append(LIBPATH=[libdir])
    print("OpenCV static lib dir: {}".format(libdir))

    # Detect version suffix from files on disk (e.g. opencv_core4100.lib)
    core_libs = glob.glob(os.path.join(libdir, "opencv_core*.lib"))
    ver = os.path.basename(core_libs[0]).replace("opencv_core", "").replace(".lib", "")
    print("OpenCV version suffix: {}".format(ver))

    env.Append(LIBS=[m + ver for m in OPENCV_MODULES])

    # 3rdparty static libs built by OpenCV (libpng, libjpeg-turbo, zlib, ...)
    # linked by full path to avoid any name-mangling issues
    third_party_libs = sorted(
        set(glob.glob(os.path.join(libdir, "*.lib")))
        - set(glob.glob(os.path.join(libdir, "opencv_*.lib")))
    )
    print("3rdparty libs: {}".format(third_party_libs))
    env.Append(LIBS=[File(f) for f in third_party_libs])

    # Windows system libs required by static opencv (videoio -> Media Foundation etc.)
    env.Append(LIBS=[
        "Mfplat", "Mf", "Mfreadwrite", "mfuuid",
        "ole32", "oleaut32", "comdlg32", "advapi32", "user32", "gdi32",
    ])

else:
    env.Append(CPPPATH=[os.path.join(opencv, "include", "opencv4")])
    env.Append(LIBPATH=[os.path.join(opencv, "lib")])

    # 3rdparty static libs (liblibpng.a, liblibjpeg-turbo.a, libzlib.a, ...)
    # linked by full path because SCons strips the "lib" prefix from LIBS names
    third_party_dir = os.path.join(opencv, "lib", "opencv4", "3rdparty")
    third_party_libs = sorted(glob.glob(os.path.join(third_party_dir, "*.a")))
    print("3rdparty libs: {}".format(third_party_libs))

    if platform == "linux":
        # --start/end-group makes static link order a non-issue
        env.Append(LINKFLAGS=["-Wl,--start-group"])
        env.Append(LIBS=OPENCV_MODULES)
        env.Append(LIBS=[File(f) for f in third_party_libs])
        env.Append(LINKFLAGS=[
            "-Wl,--end-group",
            "-static-libstdc++",
            "-static-libgcc",
        ])
        env.Append(LIBS=["pthread", "dl"])

    elif platform == "macos":
        env.Append(LIBS=OPENCV_MODULES)
        env.Append(LIBS=[File(f) for f in third_party_libs])
        for fw in ["AVFoundation", "CoreMedia", "CoreVideo", "CoreImage",
                   "Accelerate", "OpenCL", "Cocoa", "CoreGraphics", "QuartzCore"]:
            env.Append(LINKFLAGS=["-framework", fw])

print("Final LIBS: {}".format(env.get("LIBS", [])))
print("Final LIBPATH: {}".format(env.get("LIBPATH", [])))

# --- Extension sources & output ---
env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")

platform_dir = {"linux": "linux", "macos": "macos", "windows": "windows"}[platform]

output_path = "addons/gdopencv/bin/{}/libgdopencv{}{}".format(
    platform_dir, env["suffix"], env["SHLIBSUFFIX"]
)

library = env.SharedLibrary(output_path, source=sources)
Default(library)
